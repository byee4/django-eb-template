# =============================================================================
# Local secrets and config. Copy to .env, fill in values, never commit .env.
# =============================================================================

# --- Django -----------------------------------------------------------------
# DJANGO_SECRET_KEY: generate one locally via `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
DJANGO_SECRET_KEY=REPLACE_ME_GENERATE_LOCAL_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ---------------------------------------------------------------
# DATABASE_URL: leave blank to use local SQLite. In production, this is set by
# one_time_setup.sh after RDS is provisioned, e.g. postgres://user:pass@host:5432/db.
DATABASE_URL=

# --- Globus auth ------------------------------------------------------------
# GLOBUS_CLIENT_ID, GLOBUS_CLIENT_SECRET: from https://app.globus.org/settings/developers
# Register a "Portal" app and add redirect URIs:
#   local:   http://localhost:8000/complete/globus/
#   test/prod: printed by scripts/one_time_setup.sh (https://<cloudfront-or-custom-domain>/complete/globus/)
GLOBUS_CLIENT_ID=
GLOBUS_CLIENT_SECRET=
SOCIAL_AUTH_GLOBUS_REDIRECT_URI=http://localhost:8000/complete/globus/

# Who may log in. Both empty = nobody, so set at least your own identity.
# GLOBUS_ALLOWED_IDENTITIES: comma-separated Globus identity UUIDs that may log in
#   (yours: https://app.globus.org/account/identities).
# GLOBUS_ALLOWED_GROUP: a Globus group UUID; any member may log in.
GLOBUS_ALLOWED_IDENTITIES=
GLOBUS_ALLOWED_GROUP=

# --- NRP Nautilus LLM gateway ----------------------------------------------
# NRP_API_KEY: token from https://nrp.ai (Nautilus Research Platform)
# NRP_GATEWAY_BASE_URL: OpenAI-compatible endpoint
# NRP_DEFAULT_MODEL: any model the gateway exposes
NRP_API_KEY=
NRP_GATEWAY_BASE_URL=https://llm.nrp-nautilus.io/
NRP_DEFAULT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- Deployment (scripts/one_time_setup.sh {test|prod} and scripts/deploy.sh {test|prod}) ---
# PROJECT_SLUG names everything in AWS: ECR repos <slug>-test / <slug>-prod and RDS instances
# <slug>-test-db / <slug>-prod-db. Test and prod never share a database or image repository.
PROJECT_SLUG=django-template
AWS_REGION=us-west-2
EB_APP_NAME=django-template
EB_ENV_TEST=django-template-test
EB_ENV_PROD=django-template-prod

# HTTPS: leave CUSTOM_DOMAIN_<ENV> blank to get HTTPS on a default *.cloudfront.net address
# (AWS cannot issue certificates for *.elasticbeanstalk.com). With a domain, setup requests an
# ACM certificate for the load balancer; ROUTE53_ZONE_NAME (e.g. example.org.) lets it add the
# validation record automatically. A custom domain needs a load-balanced environment.
CUSTOM_DOMAIN_TEST=
CUSTOM_DOMAIN_PROD=
ROUTE53_ZONE_NAME=

# true = one instance, no load balancer (cheaper). Defaults: test true, prod false.
EB_SINGLE_INSTANCE_TEST=true
EB_SINGLE_INSTANCE_PROD=false

# RDS passwords: leave blank and one_time_setup.sh generates one per environment and saves it here.
RDS_MASTER_USERNAME=djangoapp
RDS_MASTER_PASSWORD_TEST=
RDS_MASTER_PASSWORD_PROD=
